{
	"name": "fast-cli",
	"version": "5.2.0",
	"description": "Test your download and upload speed using fast.com",
	"license": "MIT",
	"repository": "sindresorhus/fast-cli",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": "Sindre Sorhus <sindresorhus@gmail.com> (https://sindresorhus.com)",
	"type": "module",
	"bin": {
		"fast": "./distribution/cli.js"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "npm run build",
		"pretest": "npm run build",
		"test": "xo && node --import=tsx/esm --test 'test*.tsx'"
	},
	"files": [
		"distribution"
	],
	"keywords": [
		"cli-app",
		"cli",
		"speed",
		"test",
		"fast",
		"tester",
		"down",
		"download",
		"upload",
		"up",
		"speed-test",
		"speedtest",
		"connection",
		"internet",
		"bandwidth",
		"measure",
		"check",
		"mbps"
	],
	"dependencies": {
		"ink": "^7.1.1",
		"ink-spinner": "^5.0.0",
		"meow": "^14.1.0",
		"puppeteer": "^25.12.0",
		"react": "^19.3.0",
		"unicorn-magic": "^0.4.1"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"eslint-config-xo-react": "^0.32.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"execa": "^10.0.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	}
}
